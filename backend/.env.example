NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# JWT Secrets
JWT_SECRET=super-secret-taskflow-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
